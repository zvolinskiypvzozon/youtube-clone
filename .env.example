# Пример. Реальный .env создаётся автоматически: scripts/gen-env.sh (вызывается из deploy.sh).
APP_ENV=prod
LOG_LEVEL=INFO
HTTP_PORT=80

POSTGRES_USER=yt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yt
APP_DB_USER=yt_app
APP_DB_PASSWORD=change-me

SECRET_KEY=change-me-at-least-32-characters-long

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

STORAGE_ROOT_USER=root
STORAGE_ROOT_PASSWORD=change-me
S3_ACCESS_KEY=yt-app
S3_SECRET_KEY=change-me
